[Unit]
Description=Glance dashboard

[Container]
Image=docker.io/glanceapp/glance:v0.8.7
Network=web.network
Volume=%h/repo/config/glance/config:/app/config:ro,Z
Volume=%t/podman/podman.sock:/var/run/docker.sock
Volume=/srv:/srv:ro
# The dashboard's links, <service>.${INTERNAL_DOMAIN}: systemd fills it in from ~/appdata/.env
Environment=INTERNAL_DOMAIN=${INTERNAL_DOMAIN}
# With SELinux, a container can't connect to Podman's socket, and relabelling the socket
# isn't the fix: Glance runs without SELinux separation instead. It has Podman's API
# through the socket anyway.
SecurityLabelDisable=true

