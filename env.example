# ⚠️ NEVER put secrets or sensitive info in this file.

# The optional groups this host runs (folders in containers/), separated by spaces:
# lan (local network), or netbird or headscale (internet), then any others. No quotes
# around the value: link-repo.sh reads it as written.

SERVICE_GROUPS=lan media


# The internal domain the services are reached at: <service>.<internal-domain>. Changing
# it means starting over: uninstall.sh, then install.sh (docs/setup.md).

INTERNAL_DOMAIN=hearthbox


# Internet mode (netbird or headscale) only: a public domain you own. The
# VPN's server, which devices connect to from anywhere, is at nbs.<public-domain> (NetBird)
# or hs.<public-domain> (Headscale).

PUBLIC_DOMAIN=example.com
