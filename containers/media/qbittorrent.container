[Unit]
Description=qBittorrent

[Container]
Image=docker.io/qbittorrentofficial/qbittorrent-nox:5.3.0-2
Network=web.network

Environment=QBT_LEGAL_NOTICE=confirm
Environment=QBT_WEBUI_PORT=8093
Environment=QBT_TORRENTING_PORT=6881

Volume=%h/appdata/qbittorrent/config:/config:Z
Volume=/srv/hearthbox/downloads:/data/downloads

PublishPort=6881:6881/tcp
PublishPort=6881:6881/udp

ReadOnly=true
Tmpfs=/tmp
StopTimeout=1800

[Service]
TimeoutStopSec=300
